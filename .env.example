# Public URL of the deployed site, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form (https://resend.com). Without these, the form tells visitors
# to email you directly instead of pretending the message was sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@your-domain.com
# Must be on a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL="Portfolio <hello@your-domain.com>"
